# Database
DATABASE_URL=sqlite+aiosqlite:///./app.db

# LDAP Configuration
LDAP_SERVER=your-ldap-server
LDAP_BASE_DN=your_base_dn
LDAP_USER_DN=your_user_dn
LDAP_USER_FILTER=(uid=%(user)s)
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# JWT
SECRET_KEY=your-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
